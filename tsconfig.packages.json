{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "packages",
    "outDir": "artifacts/packages"
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx"],
  "exclude": ["**/node_modules", "**/dist"]
}
