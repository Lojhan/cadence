{
  "name": "cadence-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "test": "poku test --sequential",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && pnpm --filter @cadence/web exec tsc --noEmit",
    "check": "pnpm build && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm lint:rust && pnpm test",
    "boundaries": "tsx tooling/boundaries.ts",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "build:wasm": "tsx tooling/build-wasm.ts",
    "db:migrate": "tsx tooling/migrate.ts",
    "db:generate:sqlite": "pnpm --filter @cadence/db exec drizzle-kit generate --config drizzle.sqlite.ts",
    "db:generate:postgres": "pnpm --filter @cadence/db exec drizzle-kit generate --config drizzle.postgres.ts",
    "test:db": "poku test/db --sequential",
    "dev": "pnpm build:wasm && pnpm --filter @cadence/web dev",
    "build": "pnpm build:wasm && pnpm build:packages && pnpm --filter @cadence/web build",
    "start": "pnpm --filter @cadence/web start",
    "test:e2e": "poku test/browser --sequential",
    "container:build": "docker build -f deploy/Dockerfile -t cadence:test .",
    "test:container": "poku integration/container --sequential",
    "build:packages": "tsx tooling/package-release.ts",
    "eval:audio": "cargo run --quiet --locked --release -p cadence-eval --",
    "eval:wasm": "tsx tooling/evaluate-wasm.ts",
    "test:audio-parity": "poku test/evaluation/wasm-corpus.test.ts"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.14",
    "@cadence/db": "workspace:*",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "node-gyp": "12.2.0",
    "playwright": "1.63.0",
    "poku": "4.5.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wavefile": "11.0.0"
  }
}
