{
  "name": "cadence-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "test": "poku test --sequential",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm build:wasm && pnpm lint && pnpm boundaries && pnpm typecheck && pnpm lint:rust && pnpm test",
    "boundaries": "tsx tooling/boundaries.ts",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "build:wasm": "tsx tooling/build-wasm.ts"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.10.0",
    "poku": "4.5.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
