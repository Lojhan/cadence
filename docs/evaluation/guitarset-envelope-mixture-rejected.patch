     #[test]
+    fn fits_mixed_envelopes_without_erasing_a_real_upper_note() {
+        let rate = 48000;
+        let played = [(52, 0.0_f64), (55, 0.9_f64), (74, 0.7_f64)];
+        let samples: Vec<f32> = (0..WINDOW)
+            .map(|i| {
+                played
+                    .iter()
+                    .map(|(midi, shape)| {
+                        let frequency = 440.0 * 2_f64.powf((f64::from(*midi) - 69.0) / 12.0);
+                        (1..=10)
+                            .filter(|h| frequency * f64::from(*h) < 4000.0)
+                            .map(|h| {
+                                let amplitude = if *shape == 0.0 {
+                                    1.0 / f64::from(h)
+                                } else {
+                                    shape.powi(h - 1)
+                                };
+                                amplitude
+                                    * (std::f64::consts::TAU * frequency * f64::from(h) * i as f64
+                                        / f64::from(rate))
+                                    .sin()
+                            })
+                            .sum::<f64>()
+                    })
+                    .sum::<f64>() as f32
+            })
+            .collect();
+        let result = probe_at_tuning("mixed".into(), &samples, rate, 0);
+        let frame = &result.frames[0];
+        assert!(
+            frame.relative_error < 0.05,
+            "mixed envelope error: {}",
+            frame.relative_error
+        );
+        let total: f64 = frame.notes.iter().map(|note| note.strength).sum();
+        let supported: f64 = frame
+            .notes
+            .iter()
+            .filter(|note| played.iter().any(|(midi, _)| *midi == note.midi))
+            .map(|note| note.strength)
+            .sum();
+        assert!(supported / total > 0.9);
+        assert!(
+            frame
+                .notes
+                .iter()
+                .find(|note| note.midi == 74)
+                .unwrap()
+                .strength
+                / total
+                > 0.1,
+            "a real upper D must survive"
+        );
+    }
